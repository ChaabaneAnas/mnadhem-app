generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Supported courier integrations. Aramex is the only one implemented; the enum
/// is kept so Shipment and WebhookEvent stay ready for a second carrier.
enum Courier {
  ARAMEX
}

/// State machine for a shipment, driven by courier webhook events.
/// Transitions:
///   PENDING    → IN_TRANSIT  : courier confirms pickup (stock Available → Reserved)
///   IN_TRANSIT → DELIVERED   : delivery confirmed      (stock Physical & Reserved ↓)
///   IN_TRANSIT → RETURNED    : refusal / return        (stock Reserved ↓, Available ↑)
///   IN_TRANSIT → OUT_OF_ZONE : undeliverable zone      (treated same as RETURNED)
enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
  OUT_OF_ZONE
}

/// Roles a team member can hold within a tenant workspace
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Merchant-facing business state of an order, driven by merchant actions and courier webhooks.
/// Runs in parallel with ShipmentStatus (the courier-facing logistics state).
///
/// The three pre-transit states are all "stock reserved, parcel not yet collected" — they differ
/// only in how far the merchant has got with the courier's paperwork, and none of them moves stock.
/// Transitions:
///   PENDING_FULFILLMENT → READY_FOR_SHIPMENT : merchant generates AWB / label (no stock mutation)
///   READY_FOR_SHIPMENT  → PICKUP_REQUESTED   : courier accepted the pickup request (no stock mutation)
///   any pre-transit     → PROCESSING         : IN_TRANSIT webhook (stock already reserved, no mutation)
///   any pre-transit     → CANCELLED          : merchant cancels (stock rollback: Available++, Reserved--)
///   PROCESSING → DELIVERED                   : DELIVERED webhook (Physical--, Reserved--)
///   PROCESSING → RETURNED                    : RETURNED / OUT_OF_ZONE webhook (Reserved--, Available++)
enum OrderStatus {
  PENDING_FULFILLMENT
  READY_FOR_SHIPMENT
  PICKUP_REQUESTED
  PROCESSING
  DELIVERED
  RETURNED
  CANCELLED
}

/// How the tenant captures orders — determines onboarding path and sync-warning behaviour.
enum StoreType {
  MANUAL
  SHOPIFY
  WOOCOMMERCE
}

// ---------------------------------------------------------------------------
// Identity & Multi-Tenancy
// ---------------------------------------------------------------------------

/// Platform-level user account. A user can belong to multiple tenant workspaces.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  /// Preferred UI language (BCP-47 short code: "fr", "ar", "en").
  /// Synced into the NEXT_LOCALE cookie so it follows the user across devices.
  locale       String   @default("fr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships TenantMember[]
}

/// An independent merchant workspace. Stores its own courier API keys,
/// product catalog, orders, and team members in full isolation.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  /// URL-safe unique identifier used in routing and webhook paths
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// How this tenant captures orders — drives onboarding path and sync-warning guardrails
  storeType StoreType @default(MANUAL)

  members         TenantMember[]
  products        Product[]
  orders          Order[]
  webhookEvents   WebhookEvent[]
  metricSnapshots MetricSnapshot[]
  /// The tenant's carrier credentials. Replaces the former
  /// yalidineApiKey/aramexApiKey/jexportApiKey columns, which conflated the
  /// inbound webhook secret with the outbound API credential.
  courierAccounts CourierAccount[]
}

/// A tenant's Aramex credentials and shipping defaults.
///
/// This is a table rather than columns on Tenant because Aramex authenticates
/// with a six-field `ClientInfo` block — username, password, account number,
/// PIN, entity and country code — not a single API key.
///
/// Secrets are stored as `v1:<iv>:<tag>:<ciphertext>` (AES-256-GCM) and are
/// never returned by the API; Settings shows only a "configured" hint.
model CourierAccount {
  id      String  @id @default(cuid())
  courier Courier @default(ARAMEX)
  enabled Boolean @default(false)

  // --- Aramex ClientInfo (sent with every outbound request) ---
  /// Aramex login email. Not secret — shown back in Settings.
  username           String?
  passwordCipher     String?
  /// Aramex account number. Shown back in Settings.
  accountNumber      String?
  accountPinCipher   String?
  /// 3-character transmitting-party code, issued by Aramex.
  accountEntity      String?
  /// ISO 2-letter country of the account.
  accountCountryCode String?
  /// ClientInfo.Version. The manual never states the expected value (max length
  /// 4), so it is editable rather than hardcoded.
  version            String  @default("v1.0")

  // --- Shipping defaults ---
  /// EXP (Express) or DOM (Domestic).
  productGroup String @default("EXP")
  /// See Appendix A. The manual documents International Express codes only, so
  /// a domestic account needs a value supplied by Aramex.
  productType  String @default("PPX")
  /// Currency for CashOnDeliveryAmount. The manual requires USD, which does not
  /// fit a TND domestic parcel — configurable pending an answer from Aramex.
  codCurrency  String @default("USD")

  /// Routes calls to ws.dev.aramex.net instead of ws.aramex.net.
  testMode Boolean @default(true)

  // --- Shipper / pickup identity ---
  // Aramex requires a full Shipper party on every CreateShipments call, and the
  // same details again as PickupAddress/PickupContact on CreatePickup. Nothing
  // else in the app holds a merchant's physical address, so it lives here.
  // shipperEmail also stands in as the consignee email, which Aramex requires
  // (REQ24) but a COD order never captures.
  shipperCompany     String?
  shipperContactName String?
  shipperPhone       String?
  shipperCellPhone   String?
  shipperEmail       String?
  shipperLine1       String?
  shipperCity        String?
  shipperStateCode   String?
  shipperPostCode    String?
  /// ISO 2-letter. Defaults to the account country when left empty.
  shipperCountryCode String?

  /// Inbound webhook shared secret. Deliberately separate from the outbound
  /// credentials — they were one column before, so rotating either broke the other.
  webhookSecretCipher String?

  // --- Last "Test connection" result, surfaced in settings ---
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastTestError String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  /// One carrier per tenant, which is why there is no "default carrier" flag.
  @@unique([tenantId])
}

/// Junction table granting a User access to a Tenant with a specific Role.
model TenantMember {
  id       String   @id @default(cuid())
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// A top-level product in a tenant's catalog.
model Product {
  id          String   @id @default(cuid())
  name        String
  /// Merchant's own SKU reference (optional, unique per tenant)
  sku         String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft-delete timestamp — null means active, set means archived
  deletedAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  variants Variant[]

  @@index([tenantId, sku])
}

/// A specific Color/Size (or any attribute) combination of a Product.
/// Holds the three-column inventory engine that is Mnadhem's core.
model Variant {
  id    String  @id @default(cuid())
  /// Human-readable label e.g. "Blue / XL"
  name  String
  color String?
  size  String?
  /// Variant-level SKU (optional, unique per product)
  sku   String?
  /// Selling price at the time this variant was created
  price Decimal @db.Decimal(10, 2)

  // --- Triple-state inventory (all mutations must run inside a $transaction) ---
  /// Actual physical units sitting in the merchant's warehouse
  stockPhysical  Int @default(0)
  /// Units packed and currently in-transit with a courier
  stockReserved  Int @default(0)
  /// Units safe to sell: stockPhysical - stockReserved
  stockAvailable Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete timestamp — null means active, set means archived
  deletedAt DateTime?

  orderItems OrderItem[]

  @@index([productId, sku])
}

// ---------------------------------------------------------------------------
// Orders & Shipments
// ---------------------------------------------------------------------------

/// A COD order placed by a customer. Regional data (wilaya) powers
/// the Governorate Risk Matrix for refusal-rate analytics.
model Order {
  id        String @id @default(cuid())
  /// Merchant's own order reference number
  reference String @unique

  /// Total Cash on Delivery amount to be collected from the customer
  codAmount Decimal @db.Decimal(10, 2)

  // Customer details
  customerName  String
  customerPhone String

  // Regional fields for the refusal-rate risk matrix
  /// Governorate / Wilaya — primary grouping key for analytics
  wilaya  String
  commune String?
  address String?

  /// Merchant-facing business state (see OrderStatus enum for transition rules)
  status OrderStatus @default(PENDING_FULFILLMENT)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete timestamp — null means active, set means archived
  deletedAt DateTime?

  items    OrderItem[]
  shipment Shipment?

  @@index([tenantId, createdAt])
}

/// Line item linking an Order to a specific Variant at a locked-in price.
model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  /// Price per unit captured at order creation time
  unitPrice Decimal @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  @@unique([orderId, variantId])
}

/// Tracks the courier assignment, tracking number, and live delivery state
/// for a single Order. Also records floating-capital remittance.
model Shipment {
  id String @id @default(cuid())
  /// The courier's AWB / waybill number — returned by the carrier when the label
  /// is generated, and the key inbound webhooks are matched on.
  trackingNumber String         @unique
  courier        Courier
  status         ShipmentStatus @default(PENDING)

  /// Which configured carrier produced this AWB. Null for shipments created
  /// before carrier accounts existed, or entered by hand via POST /shipments.
  courierAccountId String?
  courierAccount   CourierAccount? @relation(fields: [courierAccountId], references: [id])

  // --- Label & pickup, populated by the on-demand fulfillment actions ---
  /// The label PDF itself. Stored inline so bulk printing can merge labels
  /// without re-fetching from the carrier — they are ~50-200KB each.
  labelPdf          Bytes?
  /// Carrier-hosted label URL, when the carrier returns one instead of bytes
  labelPdfUrl       String?
  awbGeneratedAt    DateTime?
  pickupReference   String?
  pickupScheduledAt DateTime?

  /// Cash collected from the customer by the courier (set on DELIVERED)
  collectedCash Decimal?  @db.Decimal(10, 2)
  /// Timestamp when the courier remitted the collected cash back to the merchant.
  /// Null until remittance occurs — used to compute total Floating Capital.
  remittedAt    DateTime?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]

  /// Backs the awaiting-remittance sum, which runs on every dashboard load
  @@index([status, remittedAt])
}

// ---------------------------------------------------------------------------
// Audit & Traceability
// ---------------------------------------------------------------------------

/// Immutable ledger entry for every courier webhook received.
/// Never updated or deleted — provides a full audit trail of all
/// inventory state changes and delivery events.
model WebhookEvent {
  id          String   @id @default(cuid())
  courier     Courier
  /// Normalized event type the adapter resolved this webhook to (e.g. "DELIVERED").
  /// The courier's own wording is not stored here — it survives in `payload`.
  eventType   String
  /// Complete raw webhook payload for forensic traceability
  payload     Json
  processedAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// Nullable: event may arrive before a Shipment record is matched
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  /// JSON snapshot of the inventory mutation applied, e.g.:
  /// { "variantId": "...", "physicalDelta": -1, "reservedDelta": -1 }
  stockDelta Json?
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

/// Daily point-in-time capture of a tenant's operational metrics.
/// Order time-series are derived live from Order.createdAt; this table
/// records snapshot-only metrics (floating capital, low-stock count) so
/// their history can be charted over time. One row per tenant per day.
model MetricSnapshot {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Calendar day this snapshot represents (no time component)
  date DateTime @db.Date

  /// COD value of orders still in transit (PROCESSING) at capture time — goods
  /// at delivery risk, where the customer has not paid anyone yet.
  cashInTransit      Decimal @default(0) @db.Decimal(12, 2)
  /// Cash the courier already collected on delivery but has not yet remitted to
  /// the merchant (Shipment.status DELIVERED with remittedAt still null).
  awaitingRemittance Decimal @default(0) @db.Decimal(12, 2)
  /// Count of variants at or below the low-stock threshold
  lowStockCount      Int     @default(0)
  /// Count of orders awaiting fulfillment (PENDING_FULFILLMENT)
  ordersToPack       Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([tenantId, date])
}
