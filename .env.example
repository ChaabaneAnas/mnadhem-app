# --- Local Postgres (docker-compose.yml) ---
POSTGRES_USER=mnadhem
POSTGRES_PASSWORD=mnadhem
POSTGRES_DB=mnadhem_db

# --- Shared by apps/web and apps/api ---
DATABASE_URL=postgresql://mnadhem:mnadhem@localhost:5432/mnadhem_db?schema=public
# Must be byte-identical across both apps: apps/web/lib/api.ts signs a JWT with
# it and apps/api verifies with the same key.
AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- apps/web ---
# NestJS base URL, read at runtime by apps/web/lib/api.ts (server-only).
# On Railway use the private network: http://api.railway.internal:3000
API_URL=http://localhost:3000
# Required on non-Vercel hosts (e.g. Railway) so Auth.js v5 trusts the
# forwarded Host header. Without it sign-in fails with UntrustedHost.
AUTH_TRUST_HOST=true

# --- apps/api ---
# Public origin of the deployed web app, added to the CORS allowlist. Optional:
# the dashboard reaches the API server-side, so this only covers direct
# browser requests.
WEB_ORIGIN=
